<!--
  Animated project showcase for the home page ("projects in action").

  Every project in _projects/ with a `loop:` (one clip) or `loops:` (several clips)
  appears here, in order of `showcase_order` (1 shows first).

  Size of each item:
  - `loops:` list            -> wide panel showing all clips in a grid
  - `showcase_size: full`    -> one card across the full width
  - `showcase_size: wide`    -> larger card, two per row
  - nothing                  -> small card, several per row
  Neighbouring wide or small cards are grouped into rows automatically.
-->
{% assign items = site.projects | where_exp: 'p', 'p.showcase_order' | sort: 'showcase_order' %}
{% assign current = '' %}

{% for project in items %}
  {% if project.loops %}
    {% assign kind = 'featured' %}
  {% elsif project.loop == nil %}
    {% continue %}
  {% elsif project.showcase_size == 'full' or project.showcase_size == 'wide' %}
    {% assign kind = project.showcase_size %}
  {% else %}
    {% assign kind = 'small' %}
  {% endif %}

  {% if kind != current %}
    {% if current == 'wide' or current == 'small' %}</div>{% endif %}
    {% if kind == 'wide' %}
      <div class="project-showcase showcase-wide">
    {% elsif kind == 'small' %}
      <div class="project-showcase">
    {% endif %}
    {% assign current = kind %}
  {% endif %}

  {% if kind == 'featured' %}
    <a class="showcase-card showcase-featured" href="{{ project.url | relative_url }}">
      <div class="showcase-grid">
        {% for clip in project.loops %}
          <div class="showcase-media">
            <video
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              {% if clip.poster %}
                poster="{{ clip.poster | relative_url }}"
              {% endif %}
              aria-label="{{ clip.label | default: project.title }}"
            >
              <source src="{{ clip.src | relative_url }}" type="video/mp4">
            </video>
            {% if clip.label %}<span class="showcase-label">{{ clip.label }}</span>{% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="showcase-caption">
        <span class="showcase-title">{{ project.short_title | default: project.title }}</span>
        {% if project.description %}<span class="showcase-desc">{{ project.description }}</span>{% endif %}
        <span class="showcase-more">view project &rarr;</span>
      </div>
    </a>
  {% else %}
    {% include project_showcase_card.liquid %}
  {% endif %}
{% endfor %}

{% if current == 'wide' or current == 'small' %}</div>{% endif %}
